    "bootstrap": "^4.6.0",
    "geobuf": "^3.0.2",
    "loader-utils": "^3.2.1",
    "lodash": "^4.17.21",
    "maplibre-gl": "^4.3.2",
    "marked": "^12.0.2",
    "numeral": "^2.0.6",
    "vue": "^2.6.12",
    "vue-filter-number-format": "^3.0.1",
    "vue-i18n": "^8.24.2",
    "vue-router": "^3.5.1",
    "vue-sorted-table": "^1.3.0",
    "vue-top-progress": "^0.7.0",
    "vue2-timeago": "^1.2.10"
  },
  "devDependencies": {
    "@babel/core": "^7.24.5",
    "@babel/preset-env": "^7.24.5",
    "babel-loader": "^9.1.3",
    "css-loader": "^7.1.1",
    "easygettext": "^2.17.0",
    "eslint": "^9.3.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import-x": "^0.5.0",
    "eslint-plugin-vue": "^9.26.0",
    "html-webpack-plugin": "^5.6.0",
    "po-loader": "0.5.0",
    "po2json": "0.4.5",
    "serve": "^14.2.6",
    "style-loader": "^4.0.0",
    "terser-webpack-plugin": "^5.3.10",
    "typescript": "^5.4.5",
    "typescript-eslint": "8.0.0-alpha.14",
    "vue-loader": "^15.11.1",
    "vue-template-compiler": "^2.7.16",
    "webpack": "^5.91.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.0.4"
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "lint": "eslint ./src",
    "lint-fix": "eslint ./src ./static",
    "build": "webpack --mode=production; cp public/assets/index.html public/index.html",
    "build-dev": "webpack --mode=development; cp public/assets/index.html public/index.html",
    "config": "cat config.template.js | envsubst '${API_URL}' > public/config.js",
    "clean": "rm -fr public/assets/* public/config.js public/index.html",
    "server": "npm run config && serve -d -s public -l 8080",
    "dev-server": "npm run config && webpack server --mode=development --env DEV_SERVER=1 --progress"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/osmose-qa/osmose-frontend.git"
  },
